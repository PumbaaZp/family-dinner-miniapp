.page-with-footer {
  padding-bottom: 180rpx;
}

.hero-links {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.hero-link {
  font-size: 26rpx;
  text-decoration: underline;
  opacity: 0.95;
  margin-right: 36rpx;
}

.empty-btn {
  width: 400rpx;
  margin: 28rpx auto 0;
}

/* 提示横幅 */
.banner-closed {
  margin-top: 20rpx;
  background: #fff4e5;
  color: #a35a12;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.banner-mine {
  margin-top: 20rpx;
  background: #eaf7ee;
  color: #2f7a45;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

/* 连不上服务器：红一点的提示条 + 右侧重试 */
.banner-err {
  margin-top: 20rpx;
  background: #fdecea;
  color: #c0392b;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.5;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.banner-retry {
  flex: none;
  margin-left: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  background: #c0392b;
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
}

/* 大家都在点什么（朋友之间互相可见） */
.board {
  background: #fff;
  border-radius: 20rpx;
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(120, 90, 70, 0.06);
}

.board-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.board-title {
  font-size: 30rpx;
  font-weight: 700;
}

.board-meta {
  font-size: 22rpx;
  color: #9c9089;
}

/* ============ 点赞：吃完给今晚的菜投票 ============ */

.like {
  background: #fff;
  border-radius: 20rpx;
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(120, 90, 70, 0.06);
  border: 2rpx solid #f6e3d8;
}

.like-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.like-title {
  font-size: 30rpx;
  font-weight: 700;
}

.like-meta {
  font-size: 22rpx;
  color: #9c9089;
}

/* 场次选择：横滑一排小标签（第 1 场 / 中秋家宴 …），回到某一次去补投 */
.like-sessions {
  margin-top: 16rpx;
  white-space: nowrap;
  width: 100%;
}

.like-session {
  display: inline-block;
  font-size: 23rpx;
  color: #7b6e66;
  background: #faf7f3;
  border: 2rpx solid #ece3d9;
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  margin-right: 12rpx;
}

.like-session-on {
  color: #fff;
  background: linear-gradient(135deg, #e05a35 0%, #c9401f 100%);
  border-color: #c9401f;
}

.like-session-mark {
  font-size: 19rpx;
  opacity: 0.85;
  margin-left: 8rpx;
}

/* 我投过谁：一眼看到自己的状态 */
.like-mine {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #2e7d5b;
  background: #eaf6f0;
  border-radius: 10rpx;
  padding: 10rpx 16rpx;
  line-height: 1.5;
}

.like-tip {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #a99d95;
  line-height: 1.6;
}

/* 「保存中…／已保存 ✓」：点一下就生效，给一条不打断操作的轻提示 */
.like-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #2e7d5b;
  text-align: right;
}

.like-hint-bad {
  color: #c0392b;
}

/* 「留个名字」：主人要靠昵称才知道是谁赞的 */
.like-hint-link {
  color: #c9401f;
  text-decoration: underline;
}

.like-empty {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #a99d95;
  line-height: 1.6;
}

.like-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f7f3ee;
}

.like-row:last-child {
  border-bottom: none;
}

/* 选中态：整行淡淡变绿，配合右侧的勾，手机上一眼看出点了哪几道 */
.like-row-on {
  background: #f2fbf7;
  border-radius: 12rpx;
}

.like-emoji {
  font-size: 36rpx;
  width: 56rpx;
  text-align: center;
  flex: none;
}

.like-main {
  flex: 1;
  min-width: 0;
  padding-left: 8rpx;
}

.like-name {
  font-size: 29rpx;
  font-weight: 600;
}

.like-sub {
  font-size: 21rpx;
  color: #a99d95;
  margin-top: 4rpx;
}

.like-box {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #e0d5cb;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #fff;
  margin-left: 12rpx;
}

.like-box-on {
  background: #4a8f5f;
  border-color: #4a8f5f;
}

.like-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.like-actions .btn {
  flex: 1;
  height: 76rpx;
  font-size: 27rpx;
}

.like-note {
  margin-top: 14rpx;
  font-size: 21rpx;
  color: #b8aca3;
  text-align: center;
}

/* 菜品行 / 看板行上的「👍 N」——参考用，别抢了菜名的注意力 */
.dish-like {
  font-size: 20rpx;
  color: #b06a3c;
  background: #fdf2e7;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-left: 10rpx;
}

.board-like {
  font-size: 20rpx;
  color: #b06a3c;
  background: #fdf2e7;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-left: 10rpx;
}

.board-empty {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #a99d95;
  line-height: 1.6;
}

.board-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 2rpx solid #f7f3ee;
}

.board-row:last-child {
  border-bottom: none;
}

.board-emoji {
  font-size: 36rpx;
  width: 56rpx;
  text-align: center;
  flex: none;
}

.board-main {
  flex: 1;
  min-width: 0;
  padding-left: 8rpx;
}

.board-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.board-name {
  font-size: 28rpx;
  font-weight: 600;
}

.board-qty {
  font-size: 28rpx;
  font-weight: 700;
  color: #c9401f;
  flex: none;
  margin-left: 16rpx;
}

.board-who {
  font-size: 22rpx;
  color: #9c9089;
  margin-top: 4rpx;
}

.board-people {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f2ece5;
}

.board-person {
  padding: 8rpx 0;
}

.board-person-nick {
  font-size: 26rpx;
  font-weight: 600;
}

.board-person-items {
  font-size: 24rpx;
  color: #6d6058;
  margin-top: 4rpx;
  line-height: 1.5;
}

/* 分类栏：吸顶——往下划也一直都看得到，不用划回去改分类 */
.cats-wrap {
  position: sticky;
  top: 0;
  z-index: 30;
  margin: 0 -24rpx;
  padding: 16rpx 24rpx;
  background: #f7f3ee;
  box-shadow: 0 6rpx 12rpx -10rpx rgba(120, 90, 70, 0.35);
}

.cats {
  white-space: nowrap;
}

.cat {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 28rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #574a42;
  box-shadow: 0 2rpx 10rpx rgba(120, 90, 70, 0.08);
}

.cat-name {
  font-size: 28rpx;
}

.cat-on .cat-name {
  font-weight: 700;
}

.cat-count {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: #a99d95;
  background: #f4efe9;
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
}

.cat-on {
  background: #2f2a26;
  color: #fff;
  font-weight: 600;
}

.cat-on .cat-count {
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
}

/* 分组标题：选「全部」时每类菜前面一条，避免所有菜连成一片 */
.cat-head {
  display: flex;
  align-items: center;
  margin: 30rpx 0 6rpx;
  padding-left: 2rpx;
}

.cat-head-bar {
  width: 8rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #e05a35, #c9401f);
  margin-right: 14rpx;
}

.cat-head-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #2f2a26;
  letter-spacing: 1rpx;
}

.cat-head-count {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #a99d95;
}

/* 紧跟分组标题的第一张卡片，别再多一层间距 */
.cat-head + .dish {
  margin-top: 12rpx;
}

/* 菜品卡片 */
.dish {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(120, 90, 70, 0.06);
}

.dish-emoji {
  font-size: 52rpx;
  width: 76rpx;
  text-align: center;
  flex: none;
}

.dish-main {
  flex: 1;
  min-width: 0;
  padding: 0 16rpx;
}

.dish-name {
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
}

.dish-limit {
  font-size: 20rpx;
  color: #c9401f;
  background: #fdecea;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 12rpx;
  font-weight: 400;
}

.dish-desc {
  font-size: 24rpx;
  color: #9c9089;
  margin-top: 8rpx;
  line-height: 1.4;
}

.dish-tags {
  margin-top: 12rpx;
}

/* 同 .input：原生 input 不能用垂直 padding，否则文字错位 */
.dish-note {
  margin-top: 14rpx;
  background: #faf7f3;
  border-radius: 10rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
}

.dish-note-ph {
  color: #bdb2aa;
  font-size: 24rpx;
}

.stepper {
  flex: none;
}

/* 底部 */
.footer-btn {
  width: 240rpx;
  flex: none;
}

.count {
  color: #c9401f;
  font-size: 32rpx;
}

.footer-tip {
  color: #4a8f5f;
}

.tips {
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #a99d95;
  line-height: 1.6;
  text-align: center;
}

/* 弹窗 */
.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(30, 20, 15, 0.45);
  z-index: 50;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 36rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  z-index: 60;
}

.sheet-title {
  font-size: 36rpx;
  font-weight: 700;
}

.sheet-sub {
  font-size: 24rpx;
  color: #9c9089;
  margin: 8rpx 0 28rpx;
}

.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}

.sheet-actions .btn {
  flex: 1;
}
