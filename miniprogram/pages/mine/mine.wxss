.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.meta-chip {
  font-size: 22rpx;
  color: #6d6058;
  background: #f7f3ee;
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
}

/* 主人调整过你的点单时的提示 */
.host-note {
  background: #fff4e5;
  color: #a35a12;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.host-note-tip {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 6rpx;
}

/* 我的点单明细 */
.mi {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f7f3ee;
}

.mi:last-child {
  border-bottom: none;
}

.mi-emoji {
  font-size: 40rpx;
  width: 60rpx;
  text-align: center;
  flex: none;
}

.mi-main {
  flex: 1;
  min-width: 0;
  padding-left: 8rpx;
}

.mi-name {
  font-size: 30rpx;
  font-weight: 600;
}

.mi-note {
  font-size: 22rpx;
  color: #b06a3c;
  margin-top: 4rpx;
}

.mi-qty {
  font-size: 28rpx;
  font-weight: 700;
  color: #c9401f;
  flex: none;
}

.order-note {
  margin-top: 20rpx;
  background: #faf7f3;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #6d6058;
  line-height: 1.5;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 26rpx;
}

.actions .btn {
  flex: 1;
  font-size: 28rpx;
}

/* 入口行 */
.entry {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #f7f3ee;
}

.entry:last-child {
  border-bottom: none;
}

.entry-emoji {
  font-size: 40rpx;
  width: 64rpx;
  text-align: center;
  flex: none;
}

.entry-main {
  flex: 1;
  min-width: 0;
  padding-left: 8rpx;
}

.entry-name {
  font-size: 30rpx;
  font-weight: 600;
}

.entry-desc {
  font-size: 22rpx;
  color: #9c9089;
  margin-top: 4rpx;
}

.entry-arrow {
  font-size: 40rpx;
  color: #c9bdb4;
  flex: none;
}

.tips {
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #a99d95;
  text-align: center;
  line-height: 1.6;
}
