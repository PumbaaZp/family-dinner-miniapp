.page-with-footer {
  padding-bottom: 60rpx;
}

.row-2 {
  display: flex;
  gap: 20rpx;
}

/* flex 子元素是外层 <picker>，flex: 1 必须加在它身上 */
.picker-cell {
  flex: 1;
  min-width: 0;
}

.picker {
  width: 100%;
  background: #faf7f3;
  border-radius: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  text-align: center;
}

.link {
  font-size: 26rpx;
  color: #c9401f;
  font-weight: 400;
}

/* 编辑态下名称不可改：灰一点，让人一眼看出这里点不动 */
.input-locked {
  background: #f2ece5;
  color: #9c9089;
}

/* 搜索框：虽然也带 .input，但自检是按"这个 class 自己的样式"判的，
   所以 height/line-height 这里再写一遍（原生 input 必须有显式高度） */
.chip-filter {
  margin-top: 22rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.chip {
  font-size: 24rpx;
  color: #7b6e66;
  background: #faf7f3;
  border: 2rpx solid #ece3d9;
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
}

/* 家里有的：一眼看出已经点过 */
.chip-on {
  color: #2e7d5b;
  background: #eaf6f0;
  border-color: #bfe3d3;
}

/* textarea 跟 input 一样是原生组件，用显式 height、不用垂直 padding */
.bulk-input {
  margin-top: 22rpx;
  width: 100%;
  height: 260rpx;
  background: #faf7f3;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  line-height: 44rpx;
}

/* 库存行 */
.prow {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f7f3ee;
}

.prow:last-child {
  border-bottom: none;
}

.prow-main {
  flex: 1;
  min-width: 0;
}

.prow-name {
  font-size: 29rpx;
  font-weight: 600;
}

.prow-note {
  font-size: 21rpx;
  color: #a99d95;
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.prow-qty {
  font-size: 24rpx;
  color: #b06a3c;
  background: #fdf2e7;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  margin-left: 12rpx;
  flex: none;
}

.prow-del {
  width: 56rpx;
  text-align: center;
  color: #c9bdb4;
  font-size: 30rpx;
  flex: none;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.actions .btn {
  flex: 1;
  font-size: 27rpx;
}

.loading {
  text-align: center;
  color: #a99d95;
  font-size: 26rpx;
  padding: 40rpx;
}
